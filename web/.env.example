# Copy to .env.local and fill in. .env.local is gitignored; keep it that way.
# Never paste a real key into THIS file — it is committed.

# Gemini API key, server-side only.
#
# This is never sent to the browser. The browser receives a single-use
# ephemeral token minted from this key, constrained to one model and one agent
# persona, valid for minutes. See src/app/api/live/token/route.ts.
#
# Also used by the post-call pipeline (summaries, department routing, QA
# scoring) and knowledge-base embeddings. Without it, live calls fail to mint
# tokens and the pipeline falls back to keyword routing.
#
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Backend switch. `/api/v1` = the built-in backend (SQLite at web/data/,
# self-seeding on first run — sign in as demo@swara.in / swara-demo).
# Unset = the console runs on its built-in demo dataset with no auth.
NEXT_PUBLIC_API_BASE_URL=/api/v1

# Metering rates, ₹. Defaults live in src/lib/server/pipeline.ts; verify
# against the current Gemini price list and your carrier contract.
# AI_INR_PER_1K_TOKENS=0.28
# TELEPHONY_INR_PER_MIN=0.45

# Telephony. The Plivo bridge (telephony/bridge.py) is a separate process that
# owns the carrier leg. It calls back into /api/internal/telephony/* with this
# secret, and "Call me now" on the Agents page posts to the bridge at this URL.
# Both unset = browser test calls only; real numbers show a clear error.
# TELEPHONY_SHARED_SECRET=            # any long random string; same value in telephony/.env
# TELEPHONY_BRIDGE_URL=http://127.0.0.1:5000

# Payments. Unset = invoice payment is recorded as simulated capture.
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
