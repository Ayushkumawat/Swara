# Copy to telephony/.env and fill in. .env is gitignored.

# Same key the console uses (web/.env.local). Server-side only.
GEMINI_API_KEY=

# Plivo → console.plivo.com → Account
PLIVO_AUTH_ID=MANGFHYJNMZJETZJI0YY
PLIVO_AUTH_TOKEN=NDIzOTc1NDUtN2IxOS00NmMzLTQ1MGUtZjI2MDNh
# A Plivo number with Voice, E.164 without the plus is fine. Used as caller ID
# for outbound and for transfers.
PLIVO_FROM_NUMBER=

# Where Plivo can reach this bridge from the internet (ngrok in dev).
# No trailing slash.
PUBLIC_URL=https://xerox-paper-reggae.ngrok-free.dev

# The Next.js console.
CONSOLE_URL=http://127.0.0.1:3000
# Must equal TELEPHONY_SHARED_SECRET in web/.env.local. Any long random string.
TELEPHONY_SHARED_SECRET=

PORT=5000
